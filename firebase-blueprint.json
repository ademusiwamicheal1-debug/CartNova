{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with tier status, reward coins, and preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "avatar": { "type": "string" },
        "tier": { "type": "string", "enum": ["Standard Shopper", "Silver VIP", "Gold VIP", "Diamond Elite", "Merchant Pro"] },
        "coins": { "type": "number" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email"]
    },
    "UserOrder": {
      "title": "UserOrder",
      "description": "Customer purchase orders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["processing", "confirmed", "dispatched", "in_transit", "delivered"] },
        "trackingNumber": { "type": "string" },
        "shippingAddress": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "items", "totalAmount", "status"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Saved wishlist product for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string" },
        "addedAt": { "type": "string" }
      },
      "required": ["id", "userId", "productId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user document containing profile data and tier rewards"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": "UserOrder",
      "description": "Orders belonging to a specific authenticated user"
    },
    "/users/{userId}/wishlist/{itemId}": {
      "schema": "WishlistItem",
      "description": "Wishlist items belonging to a specific authenticated user"
    }
  }
}
